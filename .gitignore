# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# strix security scan output (contains findings + PoCs, keep out of git)
/strix_runs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Operational scripts that talk to production Shopify and Supabase with admin/service-role
# credentials. They hold no literals today, but they are the kind of file that grows one —
# and they were previously untracked yet unignored, so a single `git add .` would commit them.
/scripts/

# Internal cost/pricing exports — real supplier costs and margins, not for the repo.
/pricing/

# Personal Claude Code permission preferences — machine-specific paths, not shared config.
.claude/settings.local.json
